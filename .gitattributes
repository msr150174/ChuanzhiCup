# 默认：文本文件统一为 LF，检出时按平台自动转换
* text=auto eol=lf

# Markdown 与文本
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 脚本：Windows 批处理保留 CRLF，其余 LF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=lf
*.sh   text eol=lf

# 二进制文件不参与换行转换
*.pdf  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.mp4  binary
*.mov  binary
