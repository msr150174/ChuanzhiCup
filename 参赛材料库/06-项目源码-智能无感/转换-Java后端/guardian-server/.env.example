# ============================================================================
#  AI 节律守护 · 环境变量模板
#
#  ⚠️ 本文件是【模板】，所有值均为占位符，不含任何真实密钥。
#     复制为 .env 后填写真实值 —— .env 已被 .gitignore 排除，不会进入仓库。
#
#  用法：
#    cp .env.example .env
#    然后按下方【填写说明】逐项填入
# ============================================================================

# ---------------------------------------------------------------- ★ Coze 智能体
# 【填写说明】登录 https://www.coze.cn → 工作空间 → 个人访问令牌 → 生成
COZE_API_TOKEN=
# 【填写说明】打开智能体页面，地址栏形如 https://www.coze.cn/space/xxx/bot/7644xxxxxxxxx
COZE_BOT_ID=
COZE_BASE_URL=https://api.coze.cn
COZE_ENABLED=true

# ---------------------------------------------------------------- 微信小程序
# 【填写说明】微信公众平台 → 开发 → 开发管理 → 开发设置
WX_APP_ID=
WX_APP_SECRET=

# ---------------------------------------------------------------- JWT
# 【填写说明】生成一个 64 位随机十六进制字符串，例：
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ---------------------------------------------------------------- 地图服务
# 【填写说明】腾讯位置服务 https://lbs.qq.com/dev/console/key/manage
TENCENT_MAP_KEY=

# ---------------------------------------------------------------- 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# 本项目的库名（智跑校园用 xyzp，两者不同库）
MYSQL_DB=znwg

# ---------------------------------------------------------------- Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------- AI 总开关
AI_ENABLED=true

# ---------------------------------------------------------------- 本地 AI（Ollama）
# 【填写说明】本地安装 Ollama 后把 OLLAMA_ENABLED 改为 true
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------------------------------------------------------------- 短信
# true = 验证码打印到日志（开发用，评审演示推荐）
SMS_DEV_MODE=true

# ---------------------------------------------------------------- 腾讯云短信（可选）
# 留空则走 dev-mode，验证码打印到控制台
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# ---------------------------------------------------------------- 服务器
SERVER_PORT=3000
